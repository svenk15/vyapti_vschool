# Run pnpm setup:local to generate a dedicated local connection in .env.
# Do not copy the previous project's DATABASE_URL.
# DATABASE_URL=postgresql://<role>:<password>@127.0.0.1:5432/vyapti_vschool
# TEST_DATABASE_URL=postgresql://<role>:<password>@127.0.0.1:5432/vyapti_vschool_test
# Run pnpm setup:auth to create authentication-only .env.local without changing .env.
# NEXTAUTH_SECRET=<random 32-byte secret>
# NEXTAUTH_URL=http://127.0.0.1:3400
# VSCHOOL_OPERATOR_ID=<verified local operator UUID>
# VSCHOOL_REPORTING_SNAPSHOT_MODE=disabled # use synthetic only for fictional local/test data
