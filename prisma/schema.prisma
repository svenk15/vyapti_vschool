generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// IAM-01 physical contracts. Checks and immutable guards are in the forward SQL migration.
model SetupCheck {
  id        String   @id(map: "vs_platform_setup_check_pkey")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("vs_platform_setup_check")
}

model Organization {
  id                   String   @id(map: "vs_access_organization_pkey") @db.Uuid
  name                 String   @db.VarChar(160)
  status               String   @db.VarChar(20)
  version              Int
  createdAt            DateTime @map("created_at") @db.Timestamptz(3)
  configurationVersion Int      @default(1) @map("configuration_version")
  schools              School[]
  institutionGrants InstitutionGrant[]
  configurationChanges ConfigurationChange[]
  tenantReceipts TenantCommandReceipt[]
  tenantOutbox TenantOutbox[]
  entitlements OrganizationEntitlement[]
  branchActivations BranchActivation[]

  @@map("vs_access_organization")
}

model School {
  id                   String             @id(map: "vs_access_school_pkey") @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  code                 String             @db.VarChar(40)
  name                 String             @db.VarChar(160)
  timezone             String             @db.VarChar(64)
  status               String             @db.VarChar(20)
  version              Int
  createdAt            DateTime           @map("created_at") @db.Timestamptz(3)
  configurationVersion Int                @default(1) @map("configuration_version")
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_school_r0_fkey")
  configurationChanges ConfigurationChange[]
  campuses             Campus[]
  memberships          SchoolMembership[]
  auditEntries         AuditEntry[]
  outboxEvents         OutboxEvent[]
  commandReceipts      CommandReceipt[]
  moduleActivations BranchActivation[]

  @@unique([organizationId, id], map: "vs_access_school_u0_key")
  @@unique([organizationId, code], map: "vs_access_school_u1_key")
  @@index([organizationId], map: "vs_access_school_r0_idx")
  @@map("vs_access_school")
}

model UserAccount {
  id                  String              @id(map: "vs_access_user_account_pkey") @db.Uuid
  normalizedEmail     String              @map("normalized_email") @db.VarChar(254)
  passwordHash        String?             @map("password_hash")
  status              String              @db.VarChar(20)
  tokenVersion        Int                 @map("token_version")
  failedAttempts      Int                 @map("failed_attempts")
  lockedUntil         DateTime?           @map("locked_until") @db.Timestamptz(3)
  version             Int
  createdAt           DateTime            @map("created_at") @db.Timestamptz(3)
  institutionGrants InstitutionGrant[]
  configurationChanges ConfigurationChange[]
  tenantReceipts TenantCommandReceipt[]
  memberships         SchoolMembership[]
  securityEvents      AuthSecurityEvent[] @relation("SecuritySubject")
  actorSecurityEvents AuthSecurityEvent[] @relation("SecurityActor")
  activations AccountActivation[] @relation("ActivationAccount")
  createdActivations AccountActivation[] @relation("ActivationCreator")
  auditEntries        AuditEntry[]
  commandReceipts     CommandReceipt[]

  @@unique([normalizedEmail], map: "vs_access_user_account_u0_key")
  @@index([status, id], map: "vs_access_user_account_q0_idx")
  @@map("vs_access_user_account")
}

model SchoolMembership {
  id             String      @id(map: "vs_access_school_membership_pkey") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  schoolId       String      @map("school_id") @db.Uuid
  accountId      String      @map("account_id") @db.Uuid
  status         String      @db.VarChar(20)
  version        Int
  school         School      @relation(fields: [organizationId, schoolId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_school_membership_r1_fkey")
  account        UserAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_school_membership_r2_fkey")
  grants         RoleGrant[]
  activationIntents AccountActivationMembership[]

  @@unique([organizationId, schoolId, id], map: "vs_access_school_membership_u0_key")
  @@unique([organizationId, schoolId, accountId], map: "vs_access_school_membership_u1_key")
  @@unique([organizationId, schoolId, id, accountId], map: "vs_access_school_membership_u2_key")
  @@index([organizationId, schoolId], map: "vs_access_school_membership_r1_idx")
  @@index([accountId], map: "vs_access_school_membership_r2_idx")
  @@map("vs_access_school_membership")
}

model RoleGrant {
  id             String           @id(map: "vs_access_role_grant_pkey") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  membershipId   String           @map("membership_id") @db.Uuid
  code           String           @db.VarChar(40)
  membership     SchoolMembership @relation(fields: [organizationId, schoolId, membershipId], references: [organizationId, schoolId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_role_grant_r3_fkey")

  @@unique([organizationId, schoolId, membershipId, code], map: "vs_access_role_grant_u0_key")
  @@index([organizationId, schoolId, membershipId], map: "vs_access_role_grant_r3_idx")
  @@map("vs_access_role_grant")
}

model AuthSecurityEvent {
  id             String       @id(map: "vs_access_auth_security_event_pkey") @db.Uuid
  accountId      String?      @map("account_id") @db.Uuid
  kind           String       @db.VarChar(40)
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)
  requestId      String       @map("request_id") @db.Uuid
  actorAccountId String?      @map("actor_account_id") @db.Uuid
  account        UserAccount? @relation("SecuritySubject", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_auth_security_event_r4_fkey")
  actorAccount   UserAccount? @relation("SecurityActor", fields: [actorAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_auth_security_event_r5_fkey")

  @@index([accountId], map: "vs_access_auth_security_event_r4_idx")
  @@index([actorAccountId], map: "vs_access_auth_security_event_r5_idx")
  @@index([accountId, occurredAt, id], map: "vs_access_auth_security_event_q0_idx")
  @@map("vs_access_auth_security_event")
}

model AuditEntry {
  id             String      @id(map: "vs_platform_audit_entry_pkey") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  schoolId       String      @map("school_id") @db.Uuid
  actorAccountId String      @map("actor_account_id") @db.Uuid
  module         String      @db.VarChar(40)
  command        String      @db.VarChar(80)
  resourceType   String      @map("resource_type") @db.VarChar(80)
  resourceId     String      @map("resource_id") @db.Uuid
  before         Json
  after          Json
  reason         String?     @db.VarChar(500)
  requestId      String      @map("request_id") @db.Uuid
  occurredAt     DateTime    @map("occurred_at") @db.Timestamptz(3)
  school         School      @relation(fields: [organizationId, schoolId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_platform_audit_entry_r6_fkey")
  actorAccount   UserAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_platform_audit_entry_r7_fkey")

  @@index([organizationId, schoolId], map: "vs_platform_audit_entry_r6_idx")
  @@index([actorAccountId], map: "vs_platform_audit_entry_r7_idx")
  @@index([organizationId, schoolId, module, resourceId, occurredAt, id], map: "vs_platform_audit_entry_q0_idx")
  @@map("vs_platform_audit_entry")
}

model OutboxEvent {
  id               String    @id(map: "vs_platform_outbox_event_pkey") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  module           String    @db.VarChar(40)
  type             String    @db.VarChar(100)
  schemaVersion    Int       @map("schema_version")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(3)
  payload          Json
  state            String    @default("PENDING") @db.VarChar(20)
  attempts         Int       @default(0)
  availableAt      DateTime  @map("available_at") @db.Timestamptz(3)
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz(3)
  school           School    @relation(fields: [organizationId, schoolId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_platform_outbox_event_r8_fkey")

  @@index([organizationId, schoolId], map: "vs_platform_outbox_event_r8_idx")
  @@index([state, availableAt, id], map: "vs_platform_outbox_event_q0_idx")
  @@map("vs_platform_outbox_event")
}

model CommandReceipt {
  id             String      @id(map: "vs_platform_command_receipt_pkey") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  schoolId       String      @map("school_id") @db.Uuid
  actorAccountId String      @map("actor_account_id") @db.Uuid
  command        String      @db.VarChar(80)
  key            String      @db.VarChar(100)
  inputHash      String      @map("input_hash") @db.Char(64)
  response       Json
  createdAt      DateTime    @map("created_at") @db.Timestamptz(3)
  school         School      @relation(fields: [organizationId, schoolId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_platform_command_receipt_r9_fkey")
  actorAccount   UserAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_platform_command_receipt_r10_fkey")

  @@unique([organizationId, schoolId, actorAccountId, command, key], map: "vs_platform_command_receipt_u0_key")
  @@index([organizationId, schoolId], map: "vs_platform_command_receipt_r9_idx")
  @@index([actorAccountId], map: "vs_platform_command_receipt_r10_idx")
  @@map("vs_platform_command_receipt")
}

model Campus {
 id String @id(map: "vs_access_campus_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 code String @db.VarChar(40)
 name String @db.VarChar(160)
 status String @db.VarChar(20)
 version Int
 school School @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_campus_school_fkey")
 @@unique([organizationId,schoolId,id],map:"vs_access_campus_scope_id_key")
 @@unique([organizationId,schoolId,code],map:"vs_access_campus_scope_code_key")
 @@map("vs_access_campus")
}

model AccountActivation {
 id String @id(map:"vs_access_account_activation_pkey") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 tokenHash String @map("token_hash") @db.Char(64)
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
 revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
 createdBy String @map("created_by") @db.Uuid
 operatorId String @map("operator_id") @db.Uuid
 caseReference String @map("case_reference") @db.VarChar(80)
 reason String @db.VarChar(500)
 issuedTokenVersion Int @map("issued_token_version")
 account UserAccount @relation("ActivationAccount",fields:[accountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_activation_r0_fkey")
 creator UserAccount @relation("ActivationCreator",fields:[createdBy],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_activation_r1_fkey")
 intents AccountActivationMembership[]
 @@unique([tokenHash],map:"vs_access_account_activation_u0_key")
 @@unique([accountId,id],map:"vs_access_account_activation_u1_key")
 @@index([accountId,expiresAt],map:"vs_access_account_activation_r0_idx")
 @@index([createdBy],map:"vs_access_account_activation_r1_idx")
 @@map("vs_access_account_activation")
}
model AccountActivationMembership {
 id String @id(map:"vs_access_account_activation_membership_pkey") @db.Uuid
 activationId String @map("activation_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 membershipId String @map("membership_id") @db.Uuid
 expectedVersion Int @map("expected_version")
 activation AccountActivation @relation(fields:[accountId,activationId],references:[accountId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_activation_membership_r0_fkey")
 membership SchoolMembership @relation(fields:[organizationId,schoolId,membershipId,accountId],references:[organizationId,schoolId,id,accountId],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_activation_membership_r1_fkey")
 @@unique([activationId,membershipId],map:"vs_access_account_activation_membership_u0_key")
 @@index([accountId,activationId],map:"vs_access_account_activation_membership_r0_idx")
 @@index([organizationId,schoolId,membershipId,accountId],map:"vs_access_account_activation_membership_r1_idx")
 @@map("vs_access_account_activation_membership")
}

model InstitutionGrant {
 id String @id(map:"vs_access_institution_grant_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 role String @db.VarChar(40)
 status String @db.VarChar(20)
 version Int
 grantedAt DateTime @map("granted_at") @db.Timestamptz(3)
 grantedBy String @map("granted_by") @db.Uuid
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_institution_grant_organization_fkey")
 account UserAccount @relation(fields:[accountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_institution_grant_account_fkey")
 @@unique([organizationId,accountId,role],map:"vs_access_institution_grant_scope_role_key")
 @@index([accountId,status,organizationId],map:"vs_access_institution_grant_account_idx")
 @@map("vs_access_institution_grant")
}
model ConfigurationChange {
 id String @id(map:"vs_tenancy_configuration_change_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String? @map("school_id") @db.Uuid
 actorAccountId String @map("actor_account_id") @db.Uuid
 expectedRevision Int @map("expected_revision")
 newRevision Int @map("new_revision")
 changes Json
 reason String @db.VarChar(500)
 occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
 requestId String @map("request_id") @db.Uuid
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_tenancy_configuration_change_org_fkey")
 school School? @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_tenancy_configuration_change_school_fkey")
 actor UserAccount @relation(fields:[actorAccountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_tenancy_configuration_change_actor_fkey")
 @@index([organizationId,occurredAt,id],map:"vs_tenancy_configuration_change_history_idx")
 @@index([organizationId,schoolId,occurredAt,id],map:"vs_tenancy_configuration_change_branch_idx")
 @@index([actorAccountId],map:"vs_tenancy_configuration_change_actor_idx")
 @@map("vs_tenancy_configuration_change")
}
model TenantCommandReceipt {
 id String @id(map:"vs_tenancy_tenant_command_receipt_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 actorAccountId String @map("actor_account_id") @db.Uuid
 command String @db.VarChar(80)
 key String @db.VarChar(100)
 inputHash String @map("input_hash") @db.Char(64)
 response Json
 createdAt DateTime @map("created_at") @db.Timestamptz(3)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_tenancy_tenant_command_receipt_org_fkey")
 actor UserAccount @relation(fields:[actorAccountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_tenancy_tenant_command_receipt_actor_fkey")
 @@unique([organizationId,actorAccountId,command,key],map:"vs_tenancy_tenant_command_receipt_intent_key")
 @@index([actorAccountId],map:"vs_tenancy_tenant_command_receipt_actor_idx")
 @@map("vs_tenancy_tenant_command_receipt")
}
model TenantOutbox {
 id String @id(map:"vs_tenancy_tenant_outbox_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 type String @db.VarChar(100)
 schemaVersion Int @map("schema_version")
 payload Json
 occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
 state String @db.VarChar(20)
 attempts Int @default(0)
 availableAt DateTime @map("available_at") @db.Timestamptz(3)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_tenancy_tenant_outbox_org_fkey")
 @@index([organizationId,state,availableAt,id],map:"vs_tenancy_tenant_outbox_delivery_idx")
 @@map("vs_tenancy_tenant_outbox")
}
model OrganizationEntitlement {
 id String @id(map:"vs_tenancy_organization_entitlement_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 moduleId String @map("module_id") @db.VarChar(40)
 state String @db.VarChar(20)
 startsAt DateTime @map("starts_at") @db.Timestamptz(3)
 endsAt DateTime? @map("ends_at") @db.Timestamptz(3)
 limits Json @default("{}")
 manifestVersion Int @map("manifest_version")
 version Int
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_tenancy_organization_entitlement_org_fkey")
 @@unique([organizationId,moduleId],map:"vs_tenancy_organization_entitlement_scope_module_key")
 @@index([organizationId,state,moduleId],map:"vs_tenancy_organization_entitlement_status_idx")
 @@map("vs_tenancy_organization_entitlement")
}
model BranchActivation {
 id String @id(map:"vs_tenancy_branch_activation_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 moduleId String @map("module_id") @db.VarChar(40)
 state String @db.VarChar(20)
 version Int
 enabledAt DateTime? @map("enabled_at") @db.Timestamptz(3)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_tenancy_branch_activation_org_fkey")
 school School @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_tenancy_branch_activation_school_fkey")
 @@unique([organizationId,schoolId,moduleId],map:"vs_tenancy_branch_activation_scope_module_key")
 @@index([organizationId,schoolId,state,moduleId],map:"vs_tenancy_branch_activation_status_idx")
 @@map("vs_tenancy_branch_activation")
}
