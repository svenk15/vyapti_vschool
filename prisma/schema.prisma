 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 actorAccountId String @map("actor_account_id") @db.Uuid
 yearId String @map("year_id") @db.Uuid
 campusId String? @map("campus_id") @db.Uuid
 namespace String @db.VarChar(40)
 schemaVersion String @map("schema_version") @db.VarChar(40)
 state String @db.VarChar(40)
 fileHash String @map("file_hash") @db.Char(64)
 sourceBytes Bytes? @map("source_bytes")
 sourceExpiresAt DateTime @map("source_expires_at") @db.Timestamptz(3)
 previewRevision Int @default(1) @map("preview_revision")
 context Json
 confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
 version Int
 createdAt DateTime @map("created_at") @db.Timestamptz(3)
 school School @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_imports_import_job_school_fkey")
 actor UserAccount @relation("ImportJobActor",fields:[actorAccountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_imports_import_job_actor_fkey")
 year AcademicYear @relation(fields:[organizationId,schoolId,yearId],references:[organizationId,schoolId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_imports_import_job_year_fkey")
 campus Campus? @relation(fields:[organizationId,schoolId,campusId],references:[organizationId,schoolId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_imports_import_job_campus_fkey")
 rows ImportRow[]
 @@unique([organizationId,schoolId,id],map:"vs_imports_import_job_scope_id_key")
 @@index([organizationId,schoolId,state,createdAt,id],map:"vs_imports_import_job_list_idx")
 @@map("vs_imports_import_job")
}

model ImportRow {
 id String @id(map:"vs_imports_import_row_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 jobId String @map("job_id") @db.Uuid
 previewRevision Int @map("preview_revision")
 rowNumber Int @map("row_number")
 inputHash String @map("input_hash") @db.Char(64)
 normalized Json?
 decision String @db.VarChar(20)
 status String @db.VarChar(20)
 expectedReferences Json @map("expected_references")
 errors Json @default("[]")
 result Json?
 errorCode String? @map("error_code") @db.VarChar(80)
 job ImportJob @relation(fields:[organizationId,schoolId,jobId],references:[organizationId,schoolId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_imports_import_row_job_fkey")
 @@unique([organizationId,schoolId,jobId,previewRevision,rowNumber],map:"vs_imports_import_row_revision_row_key")
 @@index([organizationId,schoolId,jobId,status,rowNumber],map:"vs_imports_import_row_status_idx")
 @@map("vs_imports_import_row")
}

