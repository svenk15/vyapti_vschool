generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// IAM-01 physical contracts. Checks and immutable guards are in the forward SQL migration.
model SetupCheck {
  id        String   @id(map: "vs_platform_setup_check_pkey")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("vs_platform_setup_check")
}

model Organization {
  id                   String   @id(map: "vs_access_organization_pkey") @db.Uuid
  name                 String   @db.VarChar(160)
  status               String   @db.VarChar(20)
  trustMode            String   @default("OPERATOR_CLI") @map("trust_mode") @db.VarChar(20)
  version              Int
  createdAt            DateTime @map("created_at") @db.Timestamptz(3)
  configurationVersion Int      @default(1) @map("configuration_version")
  schools              School[]
  institutionGrants InstitutionGrant[]
  configurationChanges ConfigurationChange[]
  tenantReceipts TenantCommandReceipt[]
  tenantOutbox TenantOutbox[]
  entitlements OrganizationEntitlement[]
  branchActivations BranchActivation[]
  capabilityInterests CapabilityInterest[]
  brandProfiles BrandProfile[]
  brandAssets BrandAsset[]
  verifiedBrandHosts VerifiedBrandHost[]
  brandingPublicationDelegations BrandingPublicationDelegation[]
  academicYears AcademicYear[]
  academicGrades GradeLevel[]
  academicSubjects Subject[]
  people Person[]
  accountPersonBindings AccountPersonBinding[]
  accessInvites AccessInvite[]
  passwordResetTokens PasswordResetToken[]
  admissionCycles AdmissionCycle[]
  admissionApplicants AdmissionApplicant[]
  admissionApplications AdmissionApplication[]
  academicDayPatterns AcademicDayPattern[]
  timetableRevisions TimetableRevision[]
  guardianChildAccesses GuardianChildAccess[]
  studentPortalAccesses StudentPortalAccess[]

  @@map("vs_access_organization")
}

model School {
  id                   String             @id(map: "vs_access_school_pkey") @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  code                 String             @db.VarChar(40)
  name                 String             @db.VarChar(160)
  timezone             String             @db.VarChar(64)
  officeEmail          String?            @map("office_email") @db.VarChar(254)
  officePhone          String?            @map("office_phone") @db.VarChar(40)
  officeAddress        String?            @map("office_address") @db.VarChar(500)
  supportLabel         String?            @map("support_label") @db.VarChar(160)
  supportEmail         String?            @map("support_email") @db.VarChar(254)
  supportPhone         String?            @map("support_phone") @db.VarChar(40)
  supportHours         String?            @map("support_hours") @db.VarChar(500)
  supportPublishedAt   DateTime?          @map("support_published_at") @db.Timestamptz(3)
  status               String             @db.VarChar(20)
  version              Int
  createdAt            DateTime           @map("created_at") @db.Timestamptz(3)
  configurationVersion Int                @default(1) @map("configuration_version")
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_school_r0_fkey")
  configurationChanges ConfigurationChange[]
  campuses             Campus[]
  memberships          SchoolMembership[]
  auditEntries         AuditEntry[]
  exportRuns          ExportRun[]
  outboxEvents         OutboxEvent[]
  commandReceipts      CommandReceipt[]
  moduleActivations BranchActivation[]
  capabilityInterests CapabilityInterest[]
  brandProfiles BrandProfile[]
  brandAssets BrandAsset[]
  verifiedBrandHosts VerifiedBrandHost[]
  brandingPublicationDelegations BrandingPublicationDelegation[]
  academicYears AcademicYear[]
  academicGrades GradeLevel[]
  academicSubjects Subject[]
  academicSections Section[]
  academicCalendars SchoolCalendar[]
  employees Employee[]
  accessInvites AccessInvite[]
  students Student[]
  importJobs ImportJob[]
  personNameRevisions PersonNameRevision[]
  admissionCycles AdmissionCycle[]
  admissionApplicants AdmissionApplicant[]
  admissionApplications AdmissionApplication[]
  academicDayPatterns AcademicDayPattern[]
  timetableRevisions TimetableRevision[]
  familyAccessManagerGrants FamilyAccessManagerGrant[]
  studentAccessManagerGrants StudentAccessManagerGrant[]

  @@unique([organizationId, id], map: "vs_access_school_u0_key")
  @@unique([organizationId, code], map: "vs_access_school_u1_key")
  @@index([organizationId], map: "vs_access_school_r0_idx")
  @@map("vs_access_school")
}

model UserAccount {
  id                  String              @id(map: "vs_access_user_account_pkey") @db.Uuid
  normalizedEmail     String              @map("normalized_email") @db.VarChar(254)
  emailVerifiedAt     DateTime?           @map("email_verified_at") @db.Timestamptz(3)
  passwordHash        String?             @map("password_hash")
  status              String              @db.VarChar(20)
  tokenVersion        Int                 @map("token_version")
  failedAttempts      Int                 @map("failed_attempts")
  lockedUntil         DateTime?           @map("locked_until") @db.Timestamptz(3)
  version             Int
  createdAt           DateTime            @map("created_at") @db.Timestamptz(3)
  institutionGrants InstitutionGrant[]
  configurationChanges ConfigurationChange[]
  tenantReceipts TenantCommandReceipt[]
  submittedCapabilityInterests CapabilityInterest[]
  memberships         SchoolMembership[]
  securityEvents      AuthSecurityEvent[] @relation("SecuritySubject")
  actorSecurityEvents AuthSecurityEvent[] @relation("SecurityActor")
  activations AccountActivation[] @relation("ActivationAccount")
  accessInvites AccessInvite[] @relation("InviteAccount")
  issuedInvites AccessInvite[] @relation("InviteIssuer")
  passwordResetTokens PasswordResetToken[] @relation("ResetAccount")
  createdActivations AccountActivation[] @relation("ActivationCreator")
  auditEntries        AuditEntry[]
  exportRuns          ExportRun[]
  commandReceipts     CommandReceipt[]
  publishedBrandRevisions BrandRevision[]
  publishedAcademicCalendarRevisions CalendarRevision[] @relation("AcademicRevisionPublisher")
 personBindings AccountPersonBinding[] @relation("PersonAccountBinding")
  verifiedPersonBindings AccountPersonBinding[] @relation("PersonBindingVerifier")
  createdImportJobs ImportJob[] @relation("ImportJobActor")
  attendanceRevisions AttendanceRevision[] @relation("AttendanceRevisionActor")
  personNameRevisions PersonNameRevision[] @relation("PersonNameRevisionActor")
  brandingPublicationDelegations BrandingPublicationDelegation[] @relation("BrandingPublicationDelegate")
  grantedBrandingPublicationDelegations BrandingPublicationDelegation[] @relation("BrandingPublicationGrantor")
  revokedBrandingPublicationDelegations BrandingPublicationDelegation[] @relation("BrandingPublicationRevoker")
  createdAdmissionApplications AdmissionApplication[] @relation("AdmissionApplicationCreator")
  createdAcademicDayPatterns AcademicDayPattern[] @relation("AcademicDayPatternCreator")
  createdTimetableRevisions TimetableRevision[] @relation("TimetableRevisionCreator")
  acceptedGuardianAccesses GuardianChildAccess[] @relation("GuardianAccessAccount")
  authorizedGuardianAccesses GuardianChildAccess[] @relation("GuardianAccessAuthorizer")
  revokedGuardianAccesses GuardianChildAccess[] @relation("GuardianAccessRevoker")
  intendedFamilyInvitations FamilyInvitation[] @relation("FamilyInvitationAccount")
  createdFamilyInvitations FamilyInvitation[] @relation("FamilyInvitationCreator")
  acceptedStudentPortalAccesses StudentPortalAccess[] @relation("StudentPortalAccessAccount")
  authorizedStudentPortalAccesses StudentPortalAccess[] @relation("StudentPortalAccessAuthorizer")
  revokedStudentPortalAccesses StudentPortalAccess[] @relation("StudentPortalAccessRevoker")
  intendedStudentInvitations StudentPortalInvitation[] @relation("StudentPortalInvitationAccount")
  createdStudentInvitations StudentPortalInvitation[] @relation("StudentPortalInvitationCreator")
  accountSessions AccountSession[]
  accountPreferences AccountPreference[]
  accountPreferenceReceipts AccountPreferenceReceipt[]

  @@unique([normalizedEmail], map: "vs_access_user_account_u0_key")
  @@index([status, id], map: "vs_access_user_account_q0_idx")
  @@map("vs_access_user_account")
}

model AccountSession {
 id String @id(map:"vs_access_account_session_pkey") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 tokenVersion Int @map("token_version")
 safeLabel String @map("safe_label") @db.VarChar(24)
 startedAt DateTime @map("started_at") @db.Timestamptz(3)
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
 version Int
 account UserAccount @relation(fields:[accountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_session_account_fkey")
 @@unique([accountId,id],map:"vs_access_account_session_account_id_key")
 @@index([accountId,revokedAt,expiresAt,id],map:"vs_access_account_session_account_active_idx")
 @@map("vs_access_account_session")
}

model AccountPreference {
 id String @id(map:"vs_access_account_preference_pkey") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 key String @db.VarChar(40)
 value String @db.VarChar(40)
 version Int
 updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
 account UserAccount @relation(fields:[accountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_preference_account_fkey")
 @@unique([accountId,key],map:"vs_access_account_preference_account_key_key")
 @@index([accountId,updatedAt(sort: Desc),id],map:"vs_access_account_preference_account_updated_idx")
 @@map("vs_access_account_preference")
}

model AccountPreferenceReceipt {
 id String @id(map:"vs_access_account_preference_receipt_pkey") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 command String @db.VarChar(60)
 key String @db.VarChar(100)
 inputHash String @map("input_hash") @db.Char(64)
 response Json
 occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
 account UserAccount @relation(fields:[accountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_preference_receipt_account_fkey")
 @@unique([accountId,command,key],map:"vs_access_account_preference_receipt_account_command_key_key")
 @@index([accountId,occurredAt(sort: Desc),id],map:"vs_access_account_preference_receipt_account_occurred_idx")
 @@map("vs_access_account_preference_receipt")
}

model AccountPersonBinding {
 id String @id(map:"vs_access_account_person_binding_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 personId String @map("person_id") @db.Uuid
 verifiedAt DateTime @map("verified_at") @db.Timestamptz(3)
 verifiedBy String @map("verified_by") @db.Uuid
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_person_binding_organization_fkey")
 account UserAccount @relation("PersonAccountBinding",fields:[accountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_person_binding_account_fkey")
 person Person @relation(fields:[organizationId,personId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_person_binding_person_fkey")
 verifier UserAccount @relation("PersonBindingVerifier",fields:[verifiedBy],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_person_binding_verifier_fkey")
 @@unique([organizationId,accountId],map:"vs_access_account_person_binding_org_account_key")
 @@unique([organizationId,personId],map:"vs_access_account_person_binding_org_person_key")
 @@map("vs_access_account_person_binding")
}

model FamilyAccessManagerGrant {
 id String @id(map:"vs_guardians_access_manager_grant_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 membershipId String @map("membership_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 grantedByOperatorId String @map("granted_by_operator_id") @db.Uuid
 grantedAt DateTime @map("granted_at") @db.Timestamptz(3)
 revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
 version Int
 school School @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_guardians_manager_grant_school_fkey")
 membership SchoolMembership @relation(fields:[organizationId,schoolId,membershipId,accountId],references:[organizationId,schoolId,id,accountId],onDelete:Restrict,onUpdate:Restrict,map:"vs_guardians_manager_grant_membership_fkey")
 @@unique([organizationId,schoolId,accountId],map:"vs_guardians_manager_grant_scope_account_key")
 @@index([organizationId,schoolId,accountId,revokedAt],map:"vs_guardians_manager_grant_active_idx")
 @@map("vs_guardians_access_manager_grant")
}

model GuardianChildAccess {
 id String @id(map:"vs_guardians_child_access_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 studentId String @map("student_id") @db.Uuid
 displayName String @map("display_name") @db.VarChar(160)
 normalizedEmail String @map("normalized_email") @db.VarChar(254)
 accountId String? @map("account_id") @db.Uuid
 personId String? @map("person_id") @db.Uuid
 authorizedByAccountId String @map("authorized_by_account_id") @db.Uuid
 authorizedAt DateTime @map("authorized_at") @db.Timestamptz(3)
 accessFrom DateTime @map("access_from") @db.Date
 acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
 revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
 revokedByAccountId String? @map("revoked_by_account_id") @db.Uuid
 revocationReason String? @map("revocation_reason") @db.VarChar(500)
 version Int
 createdAt DateTime @map("created_at") @db.Timestamptz(3)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_guardians_child_access_org_fkey")
 student Student @relation(fields:[organizationId,schoolId,studentId],references:[organizationId,schoolId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_guardians_child_access_student_fkey")
 account UserAccount? @relation("GuardianAccessAccount",fields:[accountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_guardians_child_access_account_fkey")
 person Person? @relation(fields:[organizationId,personId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_guardians_child_access_person_fkey")
 authorizer UserAccount @relation("GuardianAccessAuthorizer",fields:[authorizedByAccountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_guardians_child_access_authorizer_fkey")
 revoker UserAccount? @relation("GuardianAccessRevoker",fields:[revokedByAccountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_guardians_child_access_revoker_fkey")
 purposes GuardianPurposeGrant[]
 invitations FamilyInvitation[]
 @@unique([organizationId,schoolId,id],map:"vs_guardians_child_access_scope_id_key")
 @@unique([organizationId,schoolId,id,studentId],map:"vs_guardians_child_access_scope_student_key")
 @@index([organizationId,schoolId,studentId,authorizedAt(sort:Desc)],map:"vs_guardians_child_access_student_history_idx")
 @@index([accountId,revokedAt,organizationId,schoolId],map:"vs_guardians_child_access_account_idx")
 @@map("vs_guardians_child_access")
}

model GuardianPurposeGrant {
 id String @id(map:"vs_guardians_purpose_grant_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 accessId String @map("access_id") @db.Uuid
 studentId String @map("student_id") @db.Uuid
 purpose String @db.VarChar(40)
 grantedAt DateTime @map("granted_at") @db.Timestamptz(3)
 access GuardianChildAccess @relation(fields:[organizationId,schoolId,accessId,studentId],references:[organizationId,schoolId,id,studentId],onDelete:Restrict,onUpdate:Restrict,map:"vs_guardians_purpose_grant_access_fkey")
 @@unique([accessId,purpose],map:"vs_guardians_purpose_grant_access_purpose_key")
 @@index([organizationId,schoolId,studentId,purpose],map:"vs_guardians_purpose_grant_lookup_idx")
 @@map("vs_guardians_purpose_grant")
}

model FamilyInvitation {
 id String @id(map:"vs_guardians_invitation_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 accessId String @map("access_id") @db.Uuid
 intendedAccountId String @map("intended_account_id") @db.Uuid
 tokenHash String @unique(map:"vs_guardians_invitation_token_hash_key") @map("token_hash") @db.Char(64)
 deliveryStatus String @map("delivery_status") @db.VarChar(24)
 deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
 deliveryFailedAt DateTime? @map("delivery_failed_at") @db.Timestamptz(3)
 deliveryFailureReason String? @map("delivery_failure_reason") @db.VarChar(120)
 createdByAccountId String @map("created_by_account_id") @db.Uuid
 createdAt DateTime @map("created_at") @db.Timestamptz(3)
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
 revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
 version Int
 access GuardianChildAccess @relation(fields:[organizationId,schoolId,accessId],references:[organizationId,schoolId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_guardians_invitation_access_fkey")
 intendedAccount UserAccount @relation("FamilyInvitationAccount",fields:[intendedAccountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_guardians_invitation_account_fkey")
 creator UserAccount @relation("FamilyInvitationCreator",fields:[createdByAccountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_guardians_invitation_creator_fkey")
 @@index([organizationId,schoolId,accessId,createdAt(sort:Desc)],map:"vs_guardians_invitation_access_idx")
 @@index([intendedAccountId,expiresAt],map:"vs_guardians_invitation_account_expiry_idx")
 @@map("vs_guardians_invitation")
}

model StudentAccessManagerGrant {
  id                  String           @id(map: "vs_students_access_manager_grant_pkey") @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  schoolId            String           @map("school_id") @db.Uuid
  membershipId        String           @map("membership_id") @db.Uuid
  accountId           String           @map("account_id") @db.Uuid
  grantedByOperatorId String           @map("granted_by_operator_id") @db.Uuid
  grantedAt           DateTime         @map("granted_at") @db.Timestamptz(3)
  revokedAt           DateTime?        @map("revoked_at") @db.Timestamptz(3)
  version             Int
  school              School           @relation(fields: [organizationId, schoolId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_students_access_manager_grant_school_fkey")
  membership          SchoolMembership @relation(fields: [organizationId, schoolId, membershipId, accountId], references: [organizationId, schoolId, id, accountId], onDelete: Restrict, onUpdate: Restrict, map: "vs_students_access_manager_grant_membership_fkey")

  @@unique([organizationId, schoolId, accountId], map: "vs_students_access_manager_grant_scope_account_key")
  @@index([organizationId, schoolId, accountId, revokedAt], map: "vs_students_access_manager_grant_active_idx")
  @@map("vs_students_access_manager_grant")
}

model StudentPortalAccess {
  id                    String                      @id(map: "vs_students_portal_access_pkey") @db.Uuid
  organizationId        String                      @map("organization_id") @db.Uuid
  schoolId              String                      @map("school_id") @db.Uuid
  studentId             String                      @map("student_id") @db.Uuid
  normalizedEmail       String                      @map("normalized_email") @db.VarChar(254)
  accountId             String?                     @map("account_id") @db.Uuid
  authorizedByAccountId String                      @map("authorized_by_account_id") @db.Uuid
  authorizedAt          DateTime                    @map("authorized_at") @db.Timestamptz(3)
  acceptedAt            DateTime?                   @map("accepted_at") @db.Timestamptz(3)
  revokedAt             DateTime?                   @map("revoked_at") @db.Timestamptz(3)
  revokedByAccountId    String?                     @map("revoked_by_account_id") @db.Uuid
  revocationReason      String?                     @map("revocation_reason") @db.VarChar(500)
  version               Int
  createdAt             DateTime                    @map("created_at") @db.Timestamptz(3)
  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_students_portal_access_org_fkey")
  student               Student                     @relation(fields: [organizationId, schoolId, studentId], references: [organizationId, schoolId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_students_portal_access_student_fkey")
  account               UserAccount?                @relation("StudentPortalAccessAccount", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_students_portal_access_account_fkey")
  authorizer            UserAccount                 @relation("StudentPortalAccessAuthorizer", fields: [authorizedByAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_students_portal_access_authorizer_fkey")
  revoker               UserAccount?                @relation("StudentPortalAccessRevoker", fields: [revokedByAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_students_portal_access_revoker_fkey")
  purposes              StudentPortalPurposeGrant[]
  invitations           StudentPortalInvitation[]
  communicationBindings CommunicationStudentRecipientBinding[]

  @@unique([organizationId, schoolId, id], map: "vs_students_portal_access_scope_id_key")
  @@unique([organizationId, schoolId, id, studentId], map: "vs_students_portal_access_scope_student_key")
  @@index([organizationId, schoolId, studentId, authorizedAt(sort: Desc)], map: "vs_students_portal_access_student_history_idx")
  @@index([accountId, revokedAt, organizationId, schoolId], map: "vs_students_portal_access_account_idx")
  @@map("vs_students_portal_access")
}

model StudentPortalPurposeGrant {
  id             String              @id(map: "vs_students_portal_purpose_grant_pkey") @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  schoolId       String              @map("school_id") @db.Uuid
  accessId       String              @map("access_id") @db.Uuid
  studentId      String              @map("student_id") @db.Uuid
  purpose        String              @db.VarChar(40)
  grantedAt      DateTime            @map("granted_at") @db.Timestamptz(3)
  access         StudentPortalAccess @relation(fields: [organizationId, schoolId, accessId, studentId], references: [organizationId, schoolId, id, studentId], onDelete: Restrict, onUpdate: Restrict, map: "vs_students_portal_purpose_grant_access_fkey")

  @@unique([accessId, purpose], map: "vs_students_portal_purpose_grant_access_purpose_key")
  @@index([organizationId, schoolId, studentId, purpose], map: "vs_students_portal_purpose_grant_lookup_idx")
  @@map("vs_students_portal_purpose_grant")
}

model StudentPortalInvitation {
  id                    String              @id(map: "vs_students_portal_invitation_pkey") @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  schoolId              String              @map("school_id") @db.Uuid
  accessId              String              @map("access_id") @db.Uuid
  intendedAccountId     String              @map("intended_account_id") @db.Uuid
  tokenHash             String              @unique(map: "vs_students_portal_invitation_token_hash_key") @map("token_hash") @db.Char(64)
  deliveryStatus        String              @map("delivery_status") @db.VarChar(24)
  deliveredAt           DateTime?           @map("delivered_at") @db.Timestamptz(3)
  deliveryFailedAt      DateTime?           @map("delivery_failed_at") @db.Timestamptz(3)
  deliveryFailureReason String?             @map("delivery_failure_reason") @db.VarChar(120)
  createdByAccountId    String              @map("created_by_account_id") @db.Uuid
  createdAt             DateTime            @map("created_at") @db.Timestamptz(3)
  expiresAt             DateTime            @map("expires_at") @db.Timestamptz(3)
  acceptedAt            DateTime?           @map("accepted_at") @db.Timestamptz(3)
  revokedAt             DateTime?           @map("revoked_at") @db.Timestamptz(3)
  version               Int
  access                StudentPortalAccess @relation(fields: [organizationId, schoolId, accessId], references: [organizationId, schoolId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_students_portal_invitation_access_fkey")
  intendedAccount       UserAccount         @relation("StudentPortalInvitationAccount", fields: [intendedAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_students_portal_invitation_account_fkey")
  creator               UserAccount         @relation("StudentPortalInvitationCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_students_portal_invitation_creator_fkey")

  @@index([organizationId, schoolId, accessId, createdAt(sort: Desc)], map: "vs_students_portal_invitation_access_idx")
  @@index([intendedAccountId, expiresAt], map: "vs_students_portal_invitation_account_expiry_idx")
  @@map("vs_students_portal_invitation")
}

model Person {
 id String @id(map:"vs_people_person_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 firstName String @map("first_name") @db.VarChar(100)
 lastName String @default("") @map("last_name") @db.VarChar(100)
