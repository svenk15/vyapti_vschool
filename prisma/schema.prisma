}
model BrandAsset {
 id String @id(map:"vs_branding_brand_asset_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String? @map("school_id") @db.Uuid
 sha256 String @db.Char(64)
 mime String @db.VarChar(100)
 contentBytes Bytes @map("content_bytes") @db.ByteA
 bytes Int
 width Int
 height Int
 state String @db.VarChar(20)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_branding_brand_asset_org_fkey")
 school School? @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_branding_brand_asset_school_fkey")
 revisions BrandRevision[]
 @@unique([id,organizationId,schoolId],map:"vs_branding_brand_asset_owner_key")
 @@index([organizationId,schoolId,sha256],map:"vs_branding_brand_asset_digest_idx")
 @@map("vs_branding_brand_asset")
}
model VerifiedBrandHost {
 id String @id(map:"vs_branding_verified_brand_host_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String? @map("school_id") @db.Uuid
 hostname String @db.VarChar(253)
 verificationTokenHash String @map("verification_token_hash") @db.Char(64)
 state String @db.VarChar(20)
 verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
 profileId String @map("profile_id") @db.Uuid
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_branding_verified_brand_host_org_fkey")
 school School? @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_branding_verified_brand_host_school_fkey")
