generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// IAM-01 physical contracts. Checks and immutable guards are in the forward SQL migration.
model SetupCheck {
  id        String   @id(map: "vs_platform_setup_check_pkey")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("vs_platform_setup_check")
}

model Organization {
  id                   String   @id(map: "vs_access_organization_pkey") @db.Uuid
  name                 String   @db.VarChar(160)
  status               String   @db.VarChar(20)
  trustMode            String   @default("OPERATOR_CLI") @map("trust_mode") @db.VarChar(20)
  version              Int
  createdAt            DateTime @map("created_at") @db.Timestamptz(3)
  configurationVersion Int      @default(1) @map("configuration_version")
  schools              School[]
  institutionGrants InstitutionGrant[]
  configurationChanges ConfigurationChange[]
  tenantReceipts TenantCommandReceipt[]
  tenantOutbox TenantOutbox[]
  entitlements OrganizationEntitlement[]
  branchActivations BranchActivation[]
  capabilityInterests CapabilityInterest[]
  brandProfiles BrandProfile[]
  brandAssets BrandAsset[]
  verifiedBrandHosts VerifiedBrandHost[]
  academicYears AcademicYear[]
  academicGrades GradeLevel[]
  academicSubjects Subject[]
  people Person[]
  accountPersonBindings AccountPersonBinding[]
  accessInvites AccessInvite[]
  passwordResetTokens PasswordResetToken[]

  @@map("vs_access_organization")
}

model School {
  id                   String             @id(map: "vs_access_school_pkey") @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  code                 String             @db.VarChar(40)
  name                 String             @db.VarChar(160)
  timezone             String             @db.VarChar(64)
  officeEmail          String?            @map("office_email") @db.VarChar(254)
  officePhone          String?            @map("office_phone") @db.VarChar(40)
  officeAddress        String?            @map("office_address") @db.VarChar(500)
  status               String             @db.VarChar(20)
  version              Int
  createdAt            DateTime           @map("created_at") @db.Timestamptz(3)
  configurationVersion Int                @default(1) @map("configuration_version")
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_school_r0_fkey")
  configurationChanges ConfigurationChange[]
  campuses             Campus[]
  memberships          SchoolMembership[]
  auditEntries         AuditEntry[]
  exportRuns          ExportRun[]
  outboxEvents         OutboxEvent[]
  commandReceipts      CommandReceipt[]
  moduleActivations BranchActivation[]
  capabilityInterests CapabilityInterest[]
  brandProfiles BrandProfile[]
  brandAssets BrandAsset[]
  verifiedBrandHosts VerifiedBrandHost[]
  academicYears AcademicYear[]
  academicGrades GradeLevel[]
  academicSubjects Subject[]
  academicSections Section[]
  academicCalendars SchoolCalendar[]
  employees Employee[]
  accessInvites AccessInvite[]
  students Student[]
  importJobs ImportJob[]
  personNameRevisions PersonNameRevision[]

  @@unique([organizationId, id], map: "vs_access_school_u0_key")
  @@unique([organizationId, code], map: "vs_access_school_u1_key")
  @@index([organizationId], map: "vs_access_school_r0_idx")
  @@map("vs_access_school")
}

model UserAccount {
  id                  String              @id(map: "vs_access_user_account_pkey") @db.Uuid
  normalizedEmail     String              @map("normalized_email") @db.VarChar(254)
  emailVerifiedAt     DateTime?           @map("email_verified_at") @db.Timestamptz(3)
  passwordHash        String?             @map("password_hash")
  status              String              @db.VarChar(20)
  tokenVersion        Int                 @map("token_version")
  failedAttempts      Int                 @map("failed_attempts")
  lockedUntil         DateTime?           @map("locked_until") @db.Timestamptz(3)
  version             Int
  createdAt           DateTime            @map("created_at") @db.Timestamptz(3)
  institutionGrants InstitutionGrant[]
  configurationChanges ConfigurationChange[]
  tenantReceipts TenantCommandReceipt[]
  submittedCapabilityInterests CapabilityInterest[]
  memberships         SchoolMembership[]
  securityEvents      AuthSecurityEvent[] @relation("SecuritySubject")
  actorSecurityEvents AuthSecurityEvent[] @relation("SecurityActor")
  activations AccountActivation[] @relation("ActivationAccount")
  accessInvites AccessInvite[] @relation("InviteAccount")
  issuedInvites AccessInvite[] @relation("InviteIssuer")
  passwordResetTokens PasswordResetToken[] @relation("ResetAccount")
  createdActivations AccountActivation[] @relation("ActivationCreator")
  auditEntries        AuditEntry[]
  exportRuns          ExportRun[]
  commandReceipts     CommandReceipt[]
  publishedBrandRevisions BrandRevision[]
  publishedAcademicCalendarRevisions CalendarRevision[] @relation("AcademicRevisionPublisher")
 personBindings AccountPersonBinding[] @relation("PersonAccountBinding")
  verifiedPersonBindings AccountPersonBinding[] @relation("PersonBindingVerifier")
  createdImportJobs ImportJob[] @relation("ImportJobActor")
  attendanceRevisions AttendanceRevision[] @relation("AttendanceRevisionActor")
  personNameRevisions PersonNameRevision[] @relation("PersonNameRevisionActor")

  @@unique([normalizedEmail], map: "vs_access_user_account_u0_key")
  @@index([status, id], map: "vs_access_user_account_q0_idx")
  @@map("vs_access_user_account")
}

model AccountPersonBinding {
 id String @id(map:"vs_access_account_person_binding_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 personId String @map("person_id") @db.Uuid
 verifiedAt DateTime @map("verified_at") @db.Timestamptz(3)
 verifiedBy String @map("verified_by") @db.Uuid
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_person_binding_organization_fkey")
 account UserAccount @relation("PersonAccountBinding",fields:[accountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_person_binding_account_fkey")
 person Person @relation(fields:[organizationId,personId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_person_binding_person_fkey")
 verifier UserAccount @relation("PersonBindingVerifier",fields:[verifiedBy],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_account_person_binding_verifier_fkey")
 @@unique([organizationId,accountId],map:"vs_access_account_person_binding_org_account_key")
 @@unique([organizationId,personId],map:"vs_access_account_person_binding_org_person_key")
 @@map("vs_access_account_person_binding")
}

model Person {
 id String @id(map:"vs_people_person_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 firstName String @map("first_name") @db.VarChar(100)
 lastName String @default("") @map("last_name") @db.VarChar(100)
 contactEmail String? @map("contact_email") @db.VarChar(254)
 version Int
 createdAt DateTime @map("created_at") @db.Timestamptz(3)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_people_person_organization_fkey")
 employees Employee[]
 students Student[]
 accountBinding AccountPersonBinding?
 nameRevisions PersonNameRevision[]
 @@unique([organizationId,id],map:"vs_people_person_organization_id_key")
 @@index([organizationId,lastName,id],map:"vs_people_person_name_idx")
 @@map("vs_people_person")
}

model PersonNameRevision {
 id String @id(map:"vs_people_person_name_revision_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 personId String @map("person_id") @db.Uuid
 version Int
 previousFirstName String @map("previous_first_name") @db.VarChar(100)
 previousLastName String @map("previous_last_name") @db.VarChar(100)
 correctedFirstName String @map("corrected_first_name") @db.VarChar(100)
 correctedLastName String @map("corrected_last_name") @db.VarChar(100)
 reason String @db.VarChar(500)
 actorAccountId String @map("actor_account_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
 person Person @relation(fields:[organizationId,personId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_people_person_name_revision_person_fkey")
 actor UserAccount @relation("PersonNameRevisionActor",fields:[actorAccountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_people_person_name_revision_actor_fkey")
 school School @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_people_person_name_revision_school_fkey")
 @@unique([organizationId,personId,version],map:"vs_people_person_name_revision_version_key")
 @@index([organizationId,personId,version(sort: Desc)],map:"vs_people_person_name_revision_history_idx")
 @@map("vs_people_person_name_revision")
}

model Employee {
 id String @id(map:"vs_people_employee_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 personId String @map("person_id") @db.Uuid
 staffNumber String @map("staff_number") @db.VarChar(40)
 employedFrom DateTime @map("employed_from") @db.Date
 employedTo DateTime? @map("employed_to") @db.Date
 status String @db.VarChar(20)
 version Int
 school School @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_people_employee_school_fkey")
 person Person @relation(fields:[organizationId,personId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_people_employee_person_fkey")
 teacher Teacher?
 @@unique([organizationId,schoolId,id],map:"vs_people_employee_scope_id_key")
 @@unique([organizationId,schoolId,staffNumber],map:"vs_people_employee_staff_number_key")
 @@unique([organizationId,schoolId,personId],map:"vs_people_employee_person_key")
 @@map("vs_people_employee")
}


model Teacher {
 id String @id(map:"vs_academics_teacher_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 employeeId String @map("employee_id") @db.Uuid
 active Boolean
 version Int
 employee Employee @relation(fields:[organizationId,schoolId,employeeId],references:[organizationId,schoolId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_academics_teacher_employee_fkey")
 assignments TeacherAssignment[]
 @@unique([organizationId,schoolId,id],map:"vs_academics_teacher_scope_id_key")
 @@unique([organizationId,schoolId,employeeId],map:"vs_academics_teacher_employee_key")
 @@index([organizationId,schoolId,active,employeeId],map:"vs_academics_teacher_eligibility_idx")
 @@map("vs_academics_teacher")
}

model Student {
 id String @id(map:"vs_students_student_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 personId String @map("person_id") @db.Uuid
 admissionNumber String @map("admission_number") @db.VarChar(40)
 status String @db.VarChar(20)
 version Int
 createdAt DateTime @map("created_at") @db.Timestamptz(3)
 school School @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_students_student_school_fkey")
 person Person @relation(fields:[organizationId,personId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_students_student_person_fkey")
 enrollments Enrollment[]
 sourceMaps SourceStudentMap[]
 attendanceRosterEntries SessionRosterEntry[]
 @@unique([organizationId,schoolId,id],map:"vs_students_student_scope_id_key")
 @@unique([organizationId,schoolId,admissionNumber],map:"vs_students_student_admission_key")
 @@unique([organizationId,schoolId,personId],map:"vs_students_student_person_key")
 @@index([organizationId,schoolId,status,id],map:"vs_students_student_list_idx")
 @@map("vs_students_student")
}

model SchoolMembership {
  id             String      @id(map: "vs_access_school_membership_pkey") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  schoolId       String      @map("school_id") @db.Uuid
  accountId      String      @map("account_id") @db.Uuid
  status         String      @db.VarChar(20)
  version        Int
  school         School      @relation(fields: [organizationId, schoolId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_school_membership_r1_fkey")
  account        UserAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_school_membership_r2_fkey")
  grants         RoleGrant[]
  activationIntents AccountActivationMembership[]

  @@unique([organizationId, schoolId, id], map: "vs_access_school_membership_u0_key")
  @@unique([organizationId, schoolId, accountId], map: "vs_access_school_membership_u1_key")
  @@unique([organizationId, schoolId, id, accountId], map: "vs_access_school_membership_u2_key")
  @@index([organizationId, schoolId], map: "vs_access_school_membership_r1_idx")
  @@index([accountId], map: "vs_access_school_membership_r2_idx")
  @@map("vs_access_school_membership")
}

model RoleGrant {
  id             String           @id(map: "vs_access_role_grant_pkey") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  membershipId   String           @map("membership_id") @db.Uuid
  code           String           @db.VarChar(40)
  membership     SchoolMembership @relation(fields: [organizationId, schoolId, membershipId], references: [organizationId, schoolId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_role_grant_r3_fkey")

  @@unique([organizationId, schoolId, membershipId, code], map: "vs_access_role_grant_u0_key")
  @@index([organizationId, schoolId, membershipId], map: "vs_access_role_grant_r3_idx")
  @@map("vs_access_role_grant")
}

model AuthSecurityEvent {
  id             String       @id(map: "vs_access_auth_security_event_pkey") @db.Uuid
  accountId      String?      @map("account_id") @db.Uuid
  kind           String       @db.VarChar(40)
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)
  requestId      String       @map("request_id") @db.Uuid
  actorAccountId String?      @map("actor_account_id") @db.Uuid
  decision       String?      @db.VarChar(12)
  safeReason     String?      @map("safe_reason") @db.VarChar(80)
  policySnapshot Json?        @map("policy_snapshot")
  account        UserAccount? @relation("SecuritySubject", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_auth_security_event_r4_fkey")
  actorAccount   UserAccount? @relation("SecurityActor", fields: [actorAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_access_auth_security_event_r5_fkey")

  @@index([accountId], map: "vs_access_auth_security_event_r4_idx")
  @@index([actorAccountId], map: "vs_access_auth_security_event_r5_idx")
  @@index([accountId, occurredAt, id], map: "vs_access_auth_security_event_q0_idx")
  @@map("vs_access_auth_security_event")
}

model AccessInvite {
 id String @id(map:"vs_access_invite_pkey") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 inviterAccountId String @map("inviter_account_id") @db.Uuid
 tokenHash String @unique(map:"vs_access_invite_token_hash_key") @map("token_hash") @db.Char(64)
 proposedRoles String[] @map("proposed_roles")
 membershipVersion Int @map("membership_version")
 organizationConfigurationVersion Int @map("organization_configuration_version")
 schoolConfigurationVersion Int @map("school_configuration_version")
 deliveryStatus String @map("delivery_status") @db.VarChar(24)
 deliveryFailedAt DateTime? @map("delivery_failed_at") @db.Timestamptz(3)
 deliveryFailureReason String? @map("delivery_failure_reason") @db.VarChar(120)
 createdAt DateTime @map("created_at") @db.Timestamptz(3)
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
 revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
 account UserAccount @relation("InviteAccount",fields:[accountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_invite_account_fkey")
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_invite_organization_fkey")
 school School @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_invite_school_fkey")
 inviter UserAccount @relation("InviteIssuer",fields:[inviterAccountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_invite_inviter_fkey")
 @@index([organizationId,schoolId,deliveryStatus,createdAt],map:"vs_access_invite_scope_delivery_idx")
 @@index([accountId,expiresAt],map:"vs_access_invite_account_expiry_idx")
 @@map("vs_access_invite")
}

model PasswordResetToken {
 id String @id(map:"vs_access_password_reset_token_pkey") @db.Uuid
 accountId String @map("account_id") @db.Uuid
 issuingOrganizationId String? @map("issuing_organization_id") @db.Uuid
 tokenHash String @unique(map:"vs_access_password_reset_token_hash_key") @map("token_hash") @db.Char(64)
 deliveryStatus String @map("delivery_status") @db.VarChar(24)
 policySnapshot Json @map("policy_snapshot")
 organizationConfigurationVersions Json @map("organization_configuration_versions")
 deliveryFailedAt DateTime? @map("delivery_failed_at") @db.Timestamptz(3)
 deliveryFailureReason String? @map("delivery_failure_reason") @db.VarChar(120)
 createdAt DateTime @map("created_at") @db.Timestamptz(3)
 expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
 consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
 revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
 account UserAccount @relation("ResetAccount",fields:[accountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_password_reset_token_account_fkey")
 organization Organization? @relation(fields:[issuingOrganizationId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_password_reset_token_organization_fkey")
 @@index([accountId,createdAt],map:"vs_access_password_reset_token_account_created_idx")
 @@index([issuingOrganizationId,createdAt],map:"vs_access_password_reset_token_issuer_created_idx")
 @@map("vs_access_password_reset_token")
}

model AuditEntry {
  id             String      @id(map: "vs_platform_audit_entry_pkey") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  schoolId       String      @map("school_id") @db.Uuid
  actorAccountId String      @map("actor_account_id") @db.Uuid
  module         String      @db.VarChar(40)
  command        String      @db.VarChar(80)
  resourceType   String      @map("resource_type") @db.VarChar(80)
  resourceId     String      @map("resource_id") @db.Uuid
  before         Json
  after          Json
  reason         String?     @db.VarChar(500)
  requestId      String      @map("request_id") @db.Uuid
  occurredAt     DateTime    @map("occurred_at") @db.Timestamptz(3)
  school         School      @relation(fields: [organizationId, schoolId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_platform_audit_entry_r6_fkey")
  actorAccount   UserAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_platform_audit_entry_r7_fkey")

  @@index([organizationId, schoolId], map: "vs_platform_audit_entry_r6_idx")
  @@index([actorAccountId], map: "vs_platform_audit_entry_r7_idx")
  @@index([organizationId, schoolId, module, resourceId, occurredAt, id], map: "vs_platform_audit_entry_q0_idx")
  @@index([organizationId, schoolId, occurredAt(sort: Desc), id(sort: Desc)], map: "vs_platform_audit_entry_activity_idx")
  @@map("vs_platform_audit_entry")
}

model ExportRun {
 id String @id(map:"vs_reporting_export_run_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 actorAccountId String @map("actor_account_id") @db.Uuid
 filters Json
 requestedAt DateTime @map("requested_at") @db.Timestamptz(3)
 state String @db.VarChar(20)
 rowCount Int @map("row_count")
 contentHash String? @map("content_hash") @db.Char(64)
 requestId String @map("request_id") @db.Uuid
 school School @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_reporting_export_run_school_fkey")
 actorAccount UserAccount @relation(fields:[actorAccountId],references:[id],onDelete:Restrict,onUpdate:Restrict,map:"vs_reporting_export_run_actor_fkey")
 @@index([organizationId,schoolId,requestedAt,id],map:"vs_reporting_export_run_list_idx")
 @@map("vs_reporting_export_run")
}

model OperatorAuditEntry {
 id String @id @db.Uuid
 operatorId String @map("operator_id") @db.Uuid
 command String @db.VarChar(80)
 resourceType String @map("resource_type") @db.VarChar(80)
 resourceId String @map("resource_id") @db.Uuid
 occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
 details Json
 @@index([operatorId,occurredAt,id],map:"vs_platform_operator_audit_actor_idx")
 @@map("vs_platform_operator_audit")
}

model OutboxEvent {
  id               String    @id(map: "vs_platform_outbox_event_pkey") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  module           String    @db.VarChar(40)
  type             String    @db.VarChar(100)
  schemaVersion    Int       @map("schema_version")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(3)
  payload          Json
  state            String    @default("PENDING") @db.VarChar(20)
  attempts         Int       @default(0)
  availableAt      DateTime  @map("available_at") @db.Timestamptz(3)
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz(3)
  school           School    @relation(fields: [organizationId, schoolId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_platform_outbox_event_r8_fkey")

  @@index([organizationId, schoolId], map: "vs_platform_outbox_event_r8_idx")
  @@index([state, availableAt, id], map: "vs_platform_outbox_event_q0_idx")
  @@map("vs_platform_outbox_event")
}

model CommandReceipt {
  id             String      @id(map: "vs_platform_command_receipt_pkey") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  schoolId       String      @map("school_id") @db.Uuid
  actorAccountId String      @map("actor_account_id") @db.Uuid
  command        String      @db.VarChar(80)
  key            String      @db.VarChar(100)
  inputHash      String      @map("input_hash") @db.Char(64)
  response       Json
  createdAt      DateTime    @map("created_at") @db.Timestamptz(3)
  school         School      @relation(fields: [organizationId, schoolId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "vs_platform_command_receipt_r9_fkey")
  actorAccount   UserAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vs_platform_command_receipt_r10_fkey")

  @@unique([organizationId, schoolId, actorAccountId, command, key], map: "vs_platform_command_receipt_u0_key")
  @@index([organizationId, schoolId], map: "vs_platform_command_receipt_r9_idx")
  @@index([actorAccountId], map: "vs_platform_command_receipt_r10_idx")
  @@map("vs_platform_command_receipt")
}

model Campus {
 id String @id(map: "vs_access_campus_pkey") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 schoolId String @map("school_id") @db.Uuid
 code String @db.VarChar(40)
 name String @db.VarChar(160)
 status String @db.VarChar(20)
 version Int
 school School @relation(fields:[organizationId,schoolId],references:[organizationId,id],onDelete:Restrict,onUpdate:Restrict,map:"vs_access_campus_school_fkey")
 academicSections Section[]
 academicExceptions CalendarException[]
 importJobs ImportJob[]
 @@unique([organizationId,schoolId,id],map:"vs_access_campus_scope_id_key")
 @@unique([organizationId,schoolId,code],map:"vs_access_campus_scope_code_key")
 @@map("vs_access_campus")
}

model AccountActivation {
