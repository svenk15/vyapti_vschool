{
  "name": "vyapti_vschool",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3400",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3400",
    "demo:start": "VSCHOOL_COORDINATION_MODE=synthetic VSCHOOL_LEARNING_RECIPIENT_POLICY_MODE=synthetic VSCHOOL_PROTECTED_EXPLANATIONS_MODE=synthetic VSCHOOL_REPORTING_SNAPSHOT_MODE=synthetic VSCHOOL_RELEASED_MODULES=academic_core,admissions,attendance,communication,family,homework,staff_core,student_core,timetable node scripts/start-demo.mjs",
    "lint": "eslint app components lib backend shared test scripts *.ts *.mjs --no-warn-ignored",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm check:docs && pnpm check:db-design && pnpm check:boundaries && pnpm check:backend && pnpm test:unit",
    "check:docs": "node scripts/check-docs.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "db:setup": "node scripts/database.mjs dev",
    "db:generate": "prisma generate",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:functional": "node scripts/database.mjs functional",
    "test:e2e": "node scripts/database.mjs e2e",
    "next-task": "node scripts/next-task.mjs",
    "check:db-design": "node scripts/check-db-design.mjs",
    "tenancy:03:setup-runtime-roles": "node scripts/tenancy-03-setup-runtime-roles.mjs",
    "check:backend": "tsc -p backend/tsconfig.json",
    "setup:auth": "node scripts/setup-auth.mjs",
    "provision-school": "node --import tsx scripts/provision-school.ts",
    "demo:access": "node --import tsx scripts/demo-access.ts",
    "verify:access-local": "node scripts/verify-access-local.mjs",
    "issue-activation": "node --import tsx scripts/issue-activation.ts",
    "recover-account": "node --import tsx scripts/recover-account.ts",
    "demo:activation": "node --import tsx scripts/demo-activation.ts",
    "demo:task": "node scripts/demo-task.mjs",
    "institution-operator": "node --import tsx scripts/institution-operator.ts",
    "family-operator": "node --import tsx scripts/family-operator.ts",
    "student-access-operator": "node --import tsx scripts/student-access-operator.ts",
    "demo:tenancy": "node --import tsx scripts/demo-tenancy.ts",
    "verify:tenancy-local": "node scripts/verify-tenancy-local.mjs",
    "tenancy-operator": "node --import tsx scripts/tenancy-operator.ts",
    "demo:tenancy-modules": "node --import tsx scripts/demo-tenancy-modules.ts",
    "demo:branding": "node --import tsx scripts/demo-branding.ts",
    "demo:academics": "node --import tsx scripts/demo-academics.ts",
    "demo:seed": "node --import tsx scripts/demo-seed.ts",
    "imports:purge-expired": "node --import tsx scripts/imports-operator.ts purge-expired"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8",
    "dotenv": "^17",
    "zod": "^4",
    "server-only": "0.0.1",
    "next-auth": "4.24.15",
    "bcryptjs": "3.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "prisma": "7.10.0",
    "tsx": "^4",
    "@types/pg": "^8",
    "vitest": "5.0.3",
    "@playwright/test": "1.63.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "type": "module"
}
